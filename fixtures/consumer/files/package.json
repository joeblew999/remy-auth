{
  "name": "my-app",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "ci": "vp run ready && vp run test:browser && vp run test:audits",
    "translate": "remy i18n translate",
    "release": "remy release check && CHECK_LOCALES=all vp run ci && vp run publish:rehearse && remy test cwv && remy packages tag",
    "setup": "remy setup check && remy setup install && remy skills install && remy rules && remy mcp register && remy verify && vp run ready",
    "upgrade": "remy upgrade"
  },
  "dependencies": {
    "@joeblew999/remy-cli": "catalog:",
    "@joeblew999/remy-fixture-contract": "workspace:*",
    "@joeblew999/remy-showcase": "catalog:",
    "@joeblew999/remy-ui": "catalog:",
    "@orpc/server": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-start": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}

# Where this app and its docs are deployed: Vite gives every VITE_ value to the app as import.meta.env (Vite's own
# .env files: this one for every mode, .env.production or .env.development for one, .env.local for this machine
# only, never committed). The command line reads the same file (remy test, remy cloudflare). Public, not secrets:
# secrets are Wrangler's (.dev.vars, wrangler secret put).
VITE_DEPLOY_ORIGIN=https://remy-auth.gedw99.workers.dev
VITE_DOCS_ORIGIN=https://remy-auth-docs.gedw99.workers.dev

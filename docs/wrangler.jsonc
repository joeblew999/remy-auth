{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The docs Worker (.plans/docs-for-consumers.md, "Fumadocs fully"): users' docs at /docs and
  // developer docs at /dev, with their search, llms, MCP, social images and Ask AI. Apart from the app
  // Worker (remy-auth): its own size limit, deploys, AI binding and logs.
  "name": "remy-auth-docs",
  "compatibility_date": "2026-09-24",
  "main": "./src/server.ts",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": { "ENVIRONMENT": "production" },
  "assets": { "directory": "./dist/client" },
  "preview_urls": false,
  // Ask AI: the production AI Search instance remy-docs-pages (R2-synced by docs:publish, through the AI
  // Gateway remy-docs), and the rate limit on questions, 10 a minute per visitor.
  "ai_search": [{ "binding": "DOCS_SEARCH", "instance_name": "remy-docs-pages" }],
  "ratelimits": [{ "name": "ASK_LIMIT", "namespace_id": "4281", "simple": { "limit": 10, "period": 60 } }],
  "env": {
    // Working on answers (docs:ask-dev): the same Worker locally, AI Search remote. Never deployed.
    "ask": {
      "vars": { "ENVIRONMENT": "docs" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "ai_search": [{ "binding": "DOCS_SEARCH", "instance_name": "remy-docs-pages", "remote": true }],
      "ratelimits": [{ "name": "ASK_LIMIT", "namespace_id": "4281", "simple": { "limit": 10, "period": 60 } }]
    }
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true, "persist": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1 }
  }
}

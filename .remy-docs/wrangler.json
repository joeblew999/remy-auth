{
  "name": "remy-auth-docs",
  "compatibility_date": "2026-09-24",
  "main": "../packages/ui/src/docs/server.ts",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "assets": {
    "directory": "../dist/client"
  },
  "preview_urls": false,
  "ai_search": [
    {
      "binding": "DOCS_SEARCH",
      "instance_name": "remy-docs-pages"
    }
  ],
  "ratelimits": [
    {
      "name": "ASK_LIMIT",
      "namespace_id": "4281",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "env": {
    "ask": {
      "vars": {
        "ENVIRONMENT": "docs"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "ai_search": [
        {
          "binding": "DOCS_SEARCH",
          "instance_name": "remy-docs-pages",
          "remote": true
        }
      ],
      "ratelimits": [
        {
          "name": "ASK_LIMIT",
          "namespace_id": "4281",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    }
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remy-auth",
  "compatibility_date": "2026-09-24",
  // Shared source for local development, production preview and deployment.
  "main": "./src/server.ts",
  "compatibility_flags": ["nodejs_compat"],
  // Release and environment for the shared log contract (@joeblew999/remy-ui/worker).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // "production" unless a local .dev.vars says "local" (mise run auth:local): the environment policy
  // table in src/auth/environment.ts reads it, and anything unknown is production.
  "vars": { "ENVIRONMENT": "production", "EMAIL_FROM": "noreply@mail.ubuntusoftware.net" },
  // The identity database (.plans/auth-service.md): Better Auth's tables, through the numbered
  // migrations in migrations/ (mise run auth:generate, auth:migrate). Only this Worker reads or writes it.
  // DEMO_DB is the showcase's own data (the notes demo), apart from the identities, as any app keeps
  // its data in its own database: the relation engine reads who may do what from those tables alone.
  // Its migrations are in migrations-demo/ (mise run auth:migrate applies both locally).
  "d1_databases": [
    { "binding": "DB", "database_name": "remy-auth", "database_id": "4f420203-69a4-4173-9048-453002a4b8e6", "migrations_dir": "migrations" },
    { "binding": "DEMO_DB", "database_name": "remy-auth-demo", "migrations_dir": "migrations-demo" }
  ],
  // Sign-in codes leave through Cloudflare Email Service, from EMAIL_FROM: an address on a domain the
  // account has enabled for Email Sending (wrangler email sending list). A local Worker captures mail
  // instead of sending it (the environment table), so this binding is only ever used on a deployment.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@mail.ubuntusoftware.net"] }],
  // Better Auth signs and hashes with it. Local: .dev.vars (mise run auth:local). Deployed: a Worker secret.
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  "assets": { "directory": "./dist/client" },
  // Preview URLs off (2026-09-25): every uploaded version and alias was public, the recent ones with
  // the AI answers on the production index, and old versions never see the ASK_PAUSED stop. Cloudflare's
  // newer Previews are served through this same switch, so cf:preview deploys a throwaway Worker instead.
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}

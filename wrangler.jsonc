{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remy-auth",
  "compatibility_date": "2026-09-24",
  // Shared source for local development, production preview and deployment.
  // Auth and D1 bindings are added in the next slice.
  "main": "./workers/app.ts",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./build/client" },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}

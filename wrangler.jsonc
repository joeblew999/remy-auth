{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remy-auth",
  "compatibility_date": "2026-09-24",
  // Shared source for local development, production preview and deployment.
  "main": "./src/server.ts",
  "compatibility_flags": ["nodejs_compat"],
  // Release and environment for the shared log contract (@joeblew999/remy-ui/worker).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // "production" here, "staging" in env.staging below, and "local" where a local .dev.vars says so
  // (npm run local): the environment policy table in src/auth/environment.ts reads it, and
  // anything unknown is production.
  "vars": { "ENVIRONMENT": "production", "EMAIL_FROM": "noreply@mail.ubuntusoftware.net" },
  // The identity database (.plans/auth-service.md): Better Auth's tables, through the numbered
  // migrations in migrations/ (npm run auth:generate, auth:migrate). Only this Worker reads or writes it.
  // DEMO_DB is the showcase's own data (the notes demo), apart from the identities, as any app keeps
  // its data in its own database: the relation engine reads who may do what from those tables alone.
  // Its migrations are in migrations-demo/ (npm run auth:migrate applies both locally).
  "d1_databases": [
    { "binding": "DB", "database_name": "remy-auth", "database_id": "4f420203-69a4-4173-9048-453002a4b8e6", "migrations_dir": "migrations" },
    { "binding": "DEMO_DB", "database_name": "remy-auth-demo", "database_id": "c9bec7d1-4c5e-4502-8a82-ed2d016d9f7e", "migrations_dir": "migrations-demo" }
  ],
  // Sign-in codes leave through Cloudflare Email Service, from EMAIL_FROM: an address on a domain the
  // account has enabled for Email Sending (wrangler email sending list). A local Worker captures mail
  // instead of sending it (the environment table), so this binding is only ever used on a deployment.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@mail.ubuntusoftware.net"] }],
  // Better Auth signs and hashes with it. Local: .dev.vars (npm run local). Deployed: a Worker secret.
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  "assets": { "directory": "./dist/client" },
  // Preview URLs off (2026-09-25): every uploaded version and alias was public, the recent ones with
  // the AI answers on the production index, and old versions never see the ASK_PAUSED stop. Cloudflare's
  // newer Previews are served through this same switch, so cf:preview deploys a throwaway Worker instead.
  // On for Worker Previews: Workers Builds makes a throwaway Cloudflare Preview of every branch and pull request
  // (`wrangler preview`), each at https://<branch>-remy-auth.gedw99.workers.dev. This also gives every uploaded
  // version a URL of its own (owner's choice, 2026-10-17).
  "preview_urls": true,
  // What every Preview gets instead of production's bindings, which it never inherits: databases of its own,
  // shared by all Previews (migrations applied to both), and staging's policy, so the seeded people can sign
  // in. BETTER_AUTH_SECRET is a Preview base-config secret (`wrangler preview base-config secret put`).
  "previews": {
    "vars": { "ENVIRONMENT": "staging", "EMAIL_FROM": "noreply@mail.ubuntusoftware.net" },
    "d1_databases": [
      { "binding": "DB", "database_name": "remy-auth-preview", "database_id": "4ecadfd4-b626-426b-8dd8-a414f38af61d", "migrations_dir": "migrations" },
      { "binding": "DEMO_DB", "database_name": "remy-auth-demo-preview", "database_id": "624bb133-5e77-4995-b9c7-99ecf4c869cb", "migrations_dir": "migrations-demo" }
    ],
    "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@mail.ubuntusoftware.net"] }],
    "version_metadata": { "binding": "CF_VERSION_METADATA" }
  },
  // Staging (remy cloudflare staging, which builds with CLOUDFLARE_ENV=staging): the same code as its own
  // Worker, with its own two databases, so nothing a visitor does there touches production's. Its
  // environment gives it the automatic sign-in (the seeded people, one press each) beside the normal
  // one; mail is sent for real. It holds fixtures and what visitors write, never a copy of production's
  // data. Bindings and vars are not inherited by a named environment, so each is written again.
  "env": {
    "staging": {
      "name": "remy-auth-staging",
      // Staging is not built by Workers Builds and keeps version URLs off (preview_urls is inherited).
      "preview_urls": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": { "ENVIRONMENT": "staging", "EMAIL_FROM": "noreply@mail.ubuntusoftware.net" },
      "d1_databases": [
        { "binding": "DB", "database_name": "remy-auth-staging", "database_id": "3a5b3025-9bf7-418b-b923-8911b0437fbc", "migrations_dir": "migrations" },
        { "binding": "DEMO_DB", "database_name": "remy-auth-demo-staging", "database_id": "ca900198-1d91-4ee9-b797-ee18b2c87e7e", "migrations_dir": "migrations-demo" }
      ],
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@mail.ubuntusoftware.net"] }],
      "secrets": { "required": ["BETTER_AUTH_SECRET"] }
    }
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}

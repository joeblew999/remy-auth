{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remy-auth",
  "compatibility_date": "2026-09-24",
  // Shared source for local development, production preview and deployment.
  // Auth and D1 bindings are added in the next slice.
  "main": "./src/server.ts",
  "compatibility_flags": ["nodejs_compat"],
  // Release and environment for the shared log contract (@joeblew999/remy-ui/worker).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": { "ENVIRONMENT": "production" },
  "assets": { "directory": "./dist/client" },
  // Answers on /app/ask (.plans/docs-site.md): the production AI Search instance remy-docs (built-in
  // storage, one item per docs heading, routed through the AI Gateway remy-docs with its monthly
  // spend limit). It has no local emulation and no remote proxy here, so local runs and the local
  // checks see the page's "no answer" path; answers are checked against a preview.
  "ai_search": [{ "binding": "DOCS_SEARCH", "instance_name": "remy-docs" }],
  // Questions per visitor: every submitted question counts, keyed by the client's IP, 10 a minute.
  "ratelimits": [{ "name": "ASK_LIMIT", "namespace_id": "4281", "simple": { "limit": 10, "period": 60 } }],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}

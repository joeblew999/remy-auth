{
  "name": "my-app",
  "private": true,
  "type": "module",
  "dependencies": {
    "@joeblew999/remy-ui": "0.15.1"
  },
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "dev:status": "remy status",
    "dev:start": "remy start",
    "dev:change": "remy change",
    "dev:land": "remy land",
    "dev:promote": "remy promote",
    "dev:release": "remy release",
    "dev:done": "remy done",
    "plans": "remy plans",

{
  "name": "my-app",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "ci": "vp run ready && vp run test:browser && vp run test:docs && vp run test:audits",
    "translate": "remy i18n translate",
    "setup": "vp pm config set --location global //npm.pkg.github.com/:_authToken \"$(gh auth token)\" && vp install && skills experimental_install && skills experimental_sync && remy rules && vp run ready",
    "upgrade": "remy upgrade",
    "test:docs": "vp run docs#test:browser",
    "coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@joeblew999/remy-cli": "catalog:",
    "@joeblew999/remy-ui": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-start": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "skills": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.10.0 <27"
  }
}

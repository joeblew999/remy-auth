{
  "name": "my-app",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "ci": "vp run ready && vp run test:browser && vp run test:audits",
    "translate": "remy i18n translate",
    "setup": "pnpm config set --location user //npm.pkg.github.com/:_authToken \"$(gh auth token)\" && vp install && skills experimental_install && skills experimental_sync && remy rules && vp run ready",
    "upgrade": "remy upgrade"
  },
  "dependencies": {
    "@joeblew999/remy-cli": "catalog:",
    "@joeblew999/remy-ui": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-start": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "skills": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}

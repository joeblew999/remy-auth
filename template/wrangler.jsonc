{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-app",
  "compatibility_date": "2026-09-24",
  "main": "./src/server.ts",
  "compatibility_flags": ["nodejs_compat"],
  // Smart Placement: Cloudflare runs the Worker near its databases when that is faster, so a page's
  // queries are local and a visitor far from them pays one trip, not one per query.
  "placement": { "mode": "smart" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": { "ENVIRONMENT": "production" },
  "assets": { "directory": "./dist/client" },
  // On for Cloudflare's Previews: every pushed branch is built and served at https://<branch>-<name>.<subdomain>.workers.dev.
  "preview_urls": true,
  // What every Preview gets, which it never inherits from production: its environment (the test sign-in is on there)
  // and the version binding /healthz reads. An app with databases gives the Previews their own here too.
  "previews": {
    "vars": { "ENVIRONMENT": "staging" },
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true, "persist": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1 },
  },
}

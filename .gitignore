node_modules/
.wrangler/
.dev.vars
.dev.vars.*
# Vite's own: .env files are committed (public values only), .env.local ones are this machine's.
.env.local
.env.*.local
*.log
.DS_Store

# Machine-specific MCP launch paths; regenerated by npx remy mcp register.
/.codex/config.toml
/.codex/config.toml.bak
/.mcp.json
/.mcp.json.bak

# What the builds, the generators and the browser runs write, in each app (apps/*).
dist/
worker-configuration.d.ts
/packages/remy-ui/src/paraglide/
test-results/
playwright-report/
*.tsbuildinfo

/*.tgz
# Installed by npx remy skills install from skills-lock.json; not committed.
.agents/skills/
.claude/skills/
# This machine's own Claude settings, like .mcp.json.
.claude/settings.local.json
# Temporary git worktrees that agents create; machine-local.
.claude/worktrees/

.remy-docs/
/packages/remy-ui/skills/
# The command line as an app runs it, emitted from packages/remy-cli/src by its build task.
/packages/remy-cli/dist/
# Vite Plus's Git hook dispatcher, written by vp config (the prepare script); the hooks themselves are .vite-hooks/*.
.vite-hooks/_/

node_modules/
.wrangler/
.dev.vars
.dev.vars.*
.env
.env.*
!.env.example
*.log
.DS_Store

# Machine-specific MCP launch paths; regenerated by npx remy mcp register.
/.codex/config.toml
/.codex/config.toml.bak
/.mcp.json
/.mcp.json.bak

# What the builds, the generators and the browser runs write, in each app (apps/*).
dist/
worker-configuration.d.ts
/packages/ui/src/paraglide/
test-results/
playwright-report/
*.tsbuildinfo

/*.tgz
# Installed by npx remy skills install from skills-lock.json; not committed.
.agents/skills/
.claude/skills/
# Written by npx remy hooks (vp run setup): the status hook, with this machine's absolute paths, like .mcp.json.
.claude/settings.local.json
# Temporary git worktrees that agents create; machine-local.
.claude/worktrees/

.remy-docs/
/packages/ui/skills/
# The command line as an app runs it, emitted from packages/ui/src/cli by the cli task (and prepack).
/packages/ui/cli/
# Vite Plus's Git hook dispatcher, written by vp config (the prepare script); the hooks themselves are .vite-hooks/*.
.vite-hooks/_/

{
  "name": "remy-auth",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "devDependencies": {
    "@fumadocs/cli": "1.7.0",
    "auth": "1.7.6",
    "github-slugger": "2.0.0",
    "shadcn": "4.21.0"
  },
  "dependencies": {
    "@joeblew999/remy-auth-contract": "*",
    "@joeblew999/remy-showcase": "*",
    "@joeblew999/remy-ui": "*",
    "better-auth": "1.7.6"
  },
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "dev:status": "node packages/ui/src/cli/remy.ts flow status",
    "dev:start": "node packages/ui/src/cli/remy.ts flow start",
    "dev:change": "node packages/ui/src/cli/remy.ts flow change",
    "dev:land": "node packages/ui/src/cli/remy.ts flow land",
    "dev:promote": "node packages/ui/src/cli/remy.ts flow promote",
    "dev:release": "node packages/ui/src/cli/remy.ts flow release",
    "dev:done": "node packages/ui/src/cli/remy.ts flow done",
    "plans": "node packages/ui/src/cli/remy.ts plans",
    "generate": "node packages/ui/paraglide.mjs && node packages/ui/skill.mjs && tsc -p packages/ui/src/cli",
    "setup": "node packages/ui/src/cli/remy.ts setup",
    "packages": "node packages/ui/src/cli/remy.ts packages",
    "release-checks": "npm run template:check && npm run ui:verify",
    "dev": "node packages/ui/src/cli/remy.ts app dev",
    "build": "node packages/ui/src/cli/remy.ts app build",
    "preview": "node packages/ui/src/cli/remy.ts app preview",
    "test": "node packages/ui/src/cli/remy.ts test",
    "local": "node scripts/local.ts",
    "test:consumers": "bash fixtures/consumer/run.sh",
    "docs": "node packages/ui/src/cli/remy.ts docs",
    "observe": "node packages/ui/src/cli/remy.ts observe",
    "shots": "node packages/ui/src/cli/remy.ts shots",
    "api": "node packages/ui/src/cli/remy.ts api",
    "logs": "wrangler tail --format json",
    "errors": "wrangler tail --format json --status error",
    "wrangler": "wrangler",
    "browser": "chrome-devtools",
    "browser:start": "chrome-devtools start --isolated --headless --no-usage-statistics --no-performance-crux",
    "browser:stop": "chrome-devtools stop",
    "web": "modern-web-guidance",
    "codex": "codex",
    "codex:resume": "codex resume --last",
    "claude": "claude",
    "claude:resume": "claude --continue",
    "auth": "auth",
    "auth:info": "auth info",
    "auth:generate": "node scripts/auth-generate.ts",
    "auth:migrate": "wrangler d1 migrations apply DB --local && wrangler d1 migrations apply DEMO_DB --local",
    "auth:mail": "node scripts/auth-mail.ts",
    "auth:provision": "node scripts/auth-provision.ts",
    "docs:cli": "cd packages/ui/src/docs && node ../../../../node_modules/@fumadocs/cli/dist/index.js",
    "ui:components": "shadcn add button card input label badge alert field separator direction skeleton empty sidebar breadcrumb collapsible dropdown-menu avatar sheet tooltip navigation-menu use-mobile table spinner tabs --overwrite --yes",
    "ui:blocks": "shadcn add @shadcn/sidebar-16 -c packages/ui --diff src/blocks/sidebar-16/components/app-sidebar.tsx && shadcn add @shadcn/sidebar-16 -c packages/ui --diff src/blocks/sidebar-16/components/nav-main.tsx && shadcn add @shadcn/sidebar-16 -c packages/ui --diff src/blocks/sidebar-16/components/site-header.tsx",
    "ui:theme": "shadcn apply nova --only theme --yes",
    "ui:verify": "npm run ui:theme && npm run ui:components && git diff --exit-code -- packages/ui/src/components packages/ui/src/styles src/lib",
    "ui:version": "node scripts/version.ts",
    "template:check": "node scripts/template-check.ts",
    "check": "node packages/ui/src/cli/remy.ts check"
  }
}

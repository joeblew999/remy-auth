{
  "name": "remy-auth",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "devDependencies": {
    "@fumadocs/cli": "1.7.0",
    "auth": "1.7.6",
    "github-slugger": "2.0.0",
    "shadcn": "4.21.0"
  },
  "dependencies": {
    "@joeblew999/remy-auth-contract": "*",
    "@joeblew999/remy-showcase": "*",
    "@joeblew999/remy-ui": "*",
    "better-auth": "1.7.6"
  },
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "dev:status": "node packages/ui/src/cli/remy.ts status",
    "dev:start": "node packages/ui/src/cli/remy.ts start",
    "dev:change": "node packages/ui/src/cli/remy.ts change",
    "dev:land": "node packages/ui/src/cli/remy.ts land",
    "dev:promote": "node packages/ui/src/cli/remy.ts promote",
    "dev:release": "node packages/ui/src/cli/remy.ts release",
    "dev:done": "node packages/ui/src/cli/remy.ts done",
    "plans": "node packages/ui/src/cli/remy.ts plans",
    "generate": "node packages/ui/paraglide.mjs && node packages/ui/skill.mjs && tsc -p packages/ui/src/cli",
    "setup": "node packages/ui/src/cli/remy.ts setup",
    "packages": "node packages/ui/src/cli/remy.ts packages",
    "release-checks": "mise run template:check && mise run ui:verify",
    "dev": "node packages/ui/src/cli/remy.ts app dev",
    "build": "node packages/ui/src/cli/remy.ts app build",
    "preview": "node packages/ui/src/cli/remy.ts app preview",
    "test": "node packages/ui/src/cli/remy.ts test",
    "local": "node scripts/local.ts",
    "test:consumers": "bash fixtures/consumer/run.sh"
  }
}

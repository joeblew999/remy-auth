#!/usr/bin/env bash
#MISE description="STEP 0 of the flow, for each piece of work and each agent: a worktree of its own on a branch of its own from main (.claude/worktrees/<name>), installed (npm, project:prepare), with its own ports (mise.local.toml) and the flow's guard. A worktree that exists (Claude Code makes its own at the same place) is prepared, not refused; inside one, no name means this one. Work there with dev:change and dev:land; dev:done removes it when landed. The flow is tasks/dev/flow.ts"
#MISE dir="{{config_root}}"
#USAGE arg "[name]" help="The work's name: lowercase letters, digits, dashes; also the branch. Inside a worktree (Claude Code's own, say), none means this one"
# The flow is the package's command line (packages/ui/src/cli, the remy bin); npm run dev:<step> is
# the entry. This task forwards for whoever still types mise run, and goes with mise
# (.plans/tooling-in-typescript.md).
# remy-auth runs the platform's source; an app runs the package's emitted JavaScript (Node strips no types under node_modules).
if [ -f packages/ui/src/cli/remy.ts ]; then exec node packages/ui/src/cli/remy.ts start "$@"; fi
exec node ./node_modules/@joeblew999/remy-ui/cli/remy.js start "$@"

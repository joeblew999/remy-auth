#!/usr/bin/env bash
#MISE description="STEP 4 of the flow, rarely and on purpose: a release. packages:release runs every check in every language locally (project:verify, Google's audits, Core Web Vitals on a preview), then the tag, push and publish. The flow is tasks/dev/flow.ts"
#MISE dir="{{config_root}}"
# The flow is the package's command line (packages/ui/src/cli, the remy bin); npm run dev:<step> is
# the entry. This task forwards for whoever still types mise run, and goes with mise
# (.plans/tooling-in-typescript.md).
# remy-auth runs the platform's source; an app runs the package's emitted JavaScript (Node strips no types under node_modules).
if [ -f packages/ui/src/cli/remy.ts ]; then exec node packages/ui/src/cli/remy.ts release "$@"; fi
exec node ./node_modules/@joeblew999/remy-ui/cli/remy.js release "$@"

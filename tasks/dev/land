#!/usr/bin/env bash
#MISE description="STEP 2 of the flow, run by whoever did the work when it is finished and the check is green: the check, commit with <message>, fast-forward main, push (GitHub then runs every language, Google's audits and the consumer fixture in parallel), deploy staging, then translate on main last (the one writer, the Claude subscription on this machine; committed and pushed). Production is dev:promote. Refuses a branch behind main or a tree with nothing to commit; the flow is tasks/dev/flow.ts"
#MISE dir="{{config_root}}"
#USAGE arg "<message>" help="The commit message's first line: what changed, for people"
# The flow is the package's command line (packages/ui/src/cli, the remy bin); npm run dev:<step> is
# the entry. This task forwards for whoever still types mise run, and goes with mise
# (.plans/tooling-in-typescript.md).
# remy-auth runs the platform's source; an app runs the package's emitted JavaScript (Node strips no types under node_modules).
if [ -f packages/ui/src/cli/remy.ts ]; then exec node packages/ui/src/cli/remy.ts land "$@"; fi
exec node ./node_modules/@joeblew999/remy-ui/cli/remy.js land "$@"

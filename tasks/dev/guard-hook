#!/usr/bin/env bash
#MISE description="The flow's guard itself, run by the Claude Code hook dev:guard registers (stdin: the tool call as JSON). Not for hands: it reads stdin and answers with an exit code"
#MISE dir="{{config_root}}"
#MISE hide=true
# The flow is the package's command line (packages/ui/src/cli, the remy bin); npm run dev:<step> is
# the entry. This task forwards for whoever still types mise run, and goes with mise
# (.plans/tooling-in-typescript.md).
# remy-auth runs the platform's source; an app runs the package's emitted JavaScript (Node strips no types under node_modules).
if [ -f packages/ui/src/cli/remy.ts ]; then exec node packages/ui/src/cli/remy.ts guard-hook "$@"; fi
exec node ./node_modules/@joeblew999/remy-ui/cli/remy.js guard-hook "$@"

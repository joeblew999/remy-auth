#!/usr/bin/env bash
#MISE description="The last step for a worktree dev:start made: once its branch is landed, remove the worktree and the branch. Refuses while anything is uncommitted or not on main. The flow is tasks/dev/flow.ts"
#MISE dir="{{config_root}}"
# The flow is the package's command line (packages/ui/src/cli, the remy bin); npm run dev:<step> is
# the entry. This task forwards for whoever still types mise run, and goes with mise
# (.plans/tooling-in-typescript.md).
exec node ./node_modules/@joeblew999/remy-ui/src/cli/remy.ts done "$@"

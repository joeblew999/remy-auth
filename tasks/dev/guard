#!/usr/bin/env bash
#MISE description="Register the flow's hooks for this repo's agents (.claude/settings.json): PreToolUse on Bash refuses a heavy check run outside the flow (project:verify, project:test*, template:test, a bare playwright run, i18n:translate) and names the dev:* step instead; SessionStart runs dev:status, so every session opens with what is going on. project:setup and project:upgrade-ui run it; --check only verifies. The guard is tasks/dev/guard.ts, the flow tasks/dev/flow.ts"
#MISE dir="{{config_root}}"
#USAGE flag "--check" help="Verify the hook is registered as it should be; change nothing"
# The flow is the package's command line (packages/ui/src/cli, the remy bin); npm run dev:<step> is
# the entry. This task forwards for whoever still types mise run, and goes with mise
# (.plans/tooling-in-typescript.md).
exec ./node_modules/.bin/remy guard "$@"

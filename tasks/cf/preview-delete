#!/usr/bin/env bash
#MISE description="REMOTE: delete a throwaway check Worker made by cf:preview (<worker>-check-<name>); with no argument, list them. Never deletes the production Worker"
#USAGE arg "[name]" help="The check Worker's full name, e.g. remy-auth-check-4f85209"
#MISE dir="{{config_root}}"
# In TypeScript now (packages/ui/src/cli): this task forwards for whoever still types mise run, and goes with mise.
if [ -f packages/ui/src/cli/remy.ts ]; then exec node packages/ui/src/cli/remy.ts cloudflare preview-delete "$@"; fi
exec node ./node_modules/@joeblew999/remy-ui/cli/remy.js cloudflare preview-delete "$@"

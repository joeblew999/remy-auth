#!/usr/bin/env bash
#MISE description="Upload this branch as a Cloudflare preview beside production (production untouched), wait until it serves the new version, then run level 1 against it (~1 min). Builds into dist/: not alongside a local level. Pass an alias to override the branch name"
#MISE dir="{{config_root}}"
#USAGE arg "[alias]" help="Preview alias; defaults to the current git branch"
# The preview lives at https://<alias>-<worker>.<subdomain>.workers.dev. Its origin is derived
# from DEPLOY_ORIGIN and the Worker name (read by Wrangler's own config reader), baked into the
# build as PUBLIC_ORIGIN (prerendered links need it), and used as TEST_BASE_URL for the checks.
set -euo pipefail
alias="${usage_alias:-$(git rev-parse --abbrev-ref HEAD)}"
alias="$(printf '%s' "$alias" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' | sed 's/^-*//; s/-*$//' | cut -c1-40)"
worker="$(node --input-type=module -e "import { unstable_readConfig } from 'wrangler'; console.log(unstable_readConfig({}).name ?? '')")"
[ -n "$worker" ] || { echo "cf:preview: the Wrangler configuration has no Worker name" >&2; exit 1; }
host="${DEPLOY_ORIGIN#https://}"
case "$host" in
  "$worker".*.workers.dev) ;;
  *) echo "cf:preview needs DEPLOY_ORIGIN on workers.dev as https://$worker.<subdomain>.workers.dev (got $DEPLOY_ORIGIN)" >&2; exit 1 ;;
esac
origin="https://$alias-$worker.${host#"$worker".}"
echo "Preview: $origin"

export PUBLIC_ORIGIN="$origin"
./node_modules/.bin/vite build

# Wrangler records the uploaded version in its structured output file; cf:wait reads it.
output="$(mktemp)"
trap 'rm -f "$output"' EXIT
export WRANGLER_OUTPUT_FILE_PATH="$output"
./node_modules/.bin/wrangler versions upload --preview-alias "$alias"
"$(dirname "$0")/wait" "$origin" "$output"

export TEST_BASE_URL="$origin" TEST_TARGET=remote
./node_modules/.bin/playwright test --project=ours
echo "Preview passed level 1: $origin"

#!/usr/bin/env bash
#MISE description="Run the local gate (project:verify) in one language per writing system (QUICK_LOCALES; every language runs in project:verify and ui:release), then build with DEPLOY_ORIGIN as the public origin, upload to the authenticated Cloudflare account and wait until production serves the new version (~1 min), then docs:publish when the project has it. Builds into dist/: not alongside a local level. Then run project:test:remote in the background and keep working"
#MISE dir="{{config_root}}"
set -euo pipefail
: "${DEPLOY_ORIGIN:?cf:deploy needs DEPLOY_ORIGIN in [env]}"

# Nothing red reaches production: the gate runs here, not by memory. Everyday deploys check one
# language per writing system (QUICK_LOCALES, default en, ar, ja, th; owner, 2026-09-25: "We really
# don't need lang tests all the time"); every language runs at release (ui:release) and on demand
# (project:verify). CHECK_LOCALES set by the caller wins.
export CHECK_LOCALES="${CHECK_LOCALES:-${QUICK_LOCALES:-en,ar,ja,th}}"
mise run project:verify

export PUBLIC_ORIGIN="$DEPLOY_ORIGIN"
./node_modules/.bin/vite build

# Wrangler records the deployed version in its structured output file; cf:wait reads it.
output="$(mktemp)"
trap 'rm -f "$output"' EXIT
export WRANGLER_OUTPUT_FILE_PATH="$output"
./node_modules/.bin/wrangler deploy
"$(dirname "$0")/wait" "$DEPLOY_ORIGIN" "$output"
echo "Live: $DEPLOY_ORIGIN"

# The docs for AI answers go with the code: a project with a docs:publish task (remy-auth) publishes
# them after every successful deploy; one without (remy-auth-app) skips this.
if mise tasks info docs:publish >/dev/null 2>&1; then mise run docs:publish; fi

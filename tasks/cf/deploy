#!/usr/bin/env bash
#MISE description="Build (no tests; GATE=smoke|quick|full runs that tier first; releases run the full gate) with DEPLOY_ORIGIN as the public origin, upload to the authenticated Cloudflare account and wait until production serves the new version (~1 min). Builds into dist/: not alongside a local level. Then run project:test:remote in the background and keep working"
#MISE dir="{{config_root}}"
set -euo pipefail
: "${DEPLOY_ORIGIN:?cf:deploy needs DEPLOY_ORIGIN in [env]}"

# Development deploys run no tests (owner, 2026-09-25: the gate is for real releases; ui:release runs
# the full one). GATE picks a tier first, by the deployer's judgement (docs/content/dev/how-we-work.md, test tiers):
# smoke (every page answers, ~15 s), quick (every check in en and ar; also GATE=1) or full (every language).
case "${GATE:-}" in
  "") ;;
  smoke) mise run project:test:smoke ;;
  1|quick) export CHECK_LOCALES="${CHECK_LOCALES:-${QUICK_LOCALES:-en,ar}}"; mise run project:verify ;;
  full) mise run project:verify ;;
  *) echo "cf:deploy: GATE is smoke, quick or full (got $GATE)" >&2; exit 1 ;;
esac

export PUBLIC_ORIGIN="$DEPLOY_ORIGIN"
./node_modules/.bin/vite build

# Wrangler records the deployed version in its structured output file; cf:wait reads it.
output="$(mktemp)"
trap 'rm -f "$output"' EXIT
export WRANGLER_OUTPUT_FILE_PATH="$output"
./node_modules/.bin/wrangler deploy
"$(dirname "$0")/wait" "$DEPLOY_ORIGIN" "$output"
echo "Live: $DEPLOY_ORIGIN"

# The deploy proves itself with the tools, not by hand: the smoke checks against the live site.
TEST_BASE_URL="$DEPLOY_ORIGIN" mise run project:test:live


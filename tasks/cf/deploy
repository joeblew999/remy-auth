#!/usr/bin/env bash
#MISE description="Build (no tests; GATE=1 runs the quick gate first, for code visitors run; releases run the full gate) with DEPLOY_ORIGIN as the public origin, upload to the authenticated Cloudflare account and wait until production serves the new version (~1 min), then docs:publish when the project has it. Builds into dist/: not alongside a local level. Then run project:test:remote in the background and keep working"
#MISE dir="{{config_root}}"
set -euo pipefail
: "${DEPLOY_ORIGIN:?cf:deploy needs DEPLOY_ORIGIN in [env]}"

# Development deploys run no tests (owner, 2026-09-25: the gate is for real releases; ui:release runs
# the full one). GATE=1 runs the quick gate first, English and Arabic (QUICK_LOCALES),
# for changes to code that visitors run: the deployer judges (docs/how-we-work.md).
if [ "${GATE:-}" = 1 ]; then
  export CHECK_LOCALES="${CHECK_LOCALES:-${QUICK_LOCALES:-en,ar}}"
  mise run project:verify
fi

export PUBLIC_ORIGIN="$DEPLOY_ORIGIN"
./node_modules/.bin/vite build

# Wrangler records the deployed version in its structured output file; cf:wait reads it.
output="$(mktemp)"
trap 'rm -f "$output"' EXIT
export WRANGLER_OUTPUT_FILE_PATH="$output"
./node_modules/.bin/wrangler deploy
"$(dirname "$0")/wait" "$DEPLOY_ORIGIN" "$output"
echo "Live: $DEPLOY_ORIGIN"

# The docs for AI answers go with the code: a project with a docs:publish task (remy-auth) publishes
# them after every successful deploy; one without (remy-auth-app) skips this.
if mise tasks info docs:publish >/dev/null 2>&1; then mise run docs:publish; fi

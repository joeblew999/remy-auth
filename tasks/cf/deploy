#!/usr/bin/env bash
#MISE description="Build with DEPLOY_ORIGIN as the public origin, upload to the authenticated Cloudflare account and wait until production serves the new version (~20 s). Builds into dist/: not alongside a local level. Then run project:test:remote in the background and keep working"
#MISE dir="{{config_root}}"
set -euo pipefail
: "${DEPLOY_ORIGIN:?cf:deploy needs DEPLOY_ORIGIN in [env]}"

export PUBLIC_ORIGIN="$DEPLOY_ORIGIN"
./node_modules/.bin/vite build

# Wrangler records the deployed version in its structured output file; cf:wait reads it.
output="$(mktemp)"
trap 'rm -f "$output"' EXIT
export WRANGLER_OUTPUT_FILE_PATH="$output"
./node_modules/.bin/wrangler deploy
"$(dirname "$0")/wait" "$DEPLOY_ORIGIN" "$output"
echo "Live: $DEPLOY_ORIGIN"

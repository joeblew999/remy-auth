#!/usr/bin/env bash
#MISE description="LOCAL, offline, read-only (safe as a depends, in any number of worktrees at once): i18n:messages:check and i18n:docs:check together. A WARNING while coding (exit 0); an error with I18N_STRICT=1 (ui:release sets it). project:check runs it"
#MISE dir="{{config_root}}"
set -uo pipefail
mise run -q i18n:messages:check ::: i18n:docs:check && exit 0
[ -z "${I18N_STRICT:-}" ] || exit 1
echo "WARNING: translations are incomplete or stale; on main, mise run i18n:translate fills them."

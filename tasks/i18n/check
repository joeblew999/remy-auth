#!/usr/bin/env bash
#MISE description="LOCAL, instant: i18n:status's summary; a WARNING while coding (exit 0), an error with I18N_STRICT=1 (ui:release sets it). project:check runs it"
#MISE dir="{{config_root}}"
# A shell wrapper so the module beside it loads as ESM wherever this directory is included from.
set -euo pipefail
exec node "$(dirname "$0")/i18n.mjs" check "$@"

#!/usr/bin/env bash
#MISE description="LOCAL, edits files: close a plan: mise run plans:close -- <plan> \"<what shipped>\". Adds the Closed line, moves it to .plans/done/ (git mv), repoints links to and from it, strikes its now.md item. Commit yourself"
#MISE dir="{{config_root}}"
# A shell wrapper so the module beside it loads as ESM wherever this directory is included from.
set -euo pipefail
exec node "$(dirname "$0")/plans.mjs" close "$@"

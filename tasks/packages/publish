#!/usr/bin/env bash
#MISE description="Publish each package this repository publishes whose version is not on its registry yet, after project:generate; with --release vX.Y.Z also check the tag is RELEASE_PACKAGE's version and create its GitHub release from CHANGELOG.md unless it exists. The token: NODE_AUTH_TOKEN (CI), else gh auth token. packages:tag runs it; so does the tag's CI job"
#MISE dir="{{config_root}}"
#MISE tools={"aqua:cli/cli"="2.101.0"}
#USAGE flag "--release <tag>" help="The release tag, e.g. v0.14.0"
#USAGE flag "--dry-run" help="Ask each registry and run npm publish --dry-run; publish nothing, create no release"
set -euo pipefail
here="$(dirname "$0")"
tag="${usage_release:-}"
dry=()
[ "${usage_dry_run:-false}" = true ] && dry=(--dry-run)
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

if [ -n "$tag" ]; then
  lead="${RELEASE_PACKAGE:?set RELEASE_PACKAGE in mise.toml [env]: the package whose version names the release}"
  version=$(node "$here/workspaces.mjs" | awk -F'\t' -v n="$lead" '$1 == n {print $2}')
  [ -n "$version" ] || { echo "packages:publish: RELEASE_PACKAGE $lead is not a published workspace here." >&2; exit 1; }
  [ "$tag" = "v$version" ] || { echo "packages:publish: tag $tag is not $lead's version v$version." >&2; exit 1; }
  mise run packages:notes -- "$version" > "$tmp/notes.md"
fi

token="${NODE_AUTH_TOKEN:-$(gh auth token)}"
# An app's own .npmrc (the blank app's) reads ${GITHUB_TOKEN} and outranks the user config written below.
export GITHUB_TOKEN="$token" NODE_AUTH_TOKEN="$token"
mise run project:generate
while IFS=$'\t' read -r name version registry _; do
  host="${registry#https://}"; host="${host%/}"
  printf '//%s/:_authToken=%s\n' "$host" "$token" > "$tmp/npmrc"
  # The token npm will publish with is accepted (a registry answers "not found" for a new name whatever the
  # token, so only whoami shows a refused one, e.g. an app's .npmrc reading an unset ${GITHUB_TOKEN}).
  NPM_CONFIG_USERCONFIG="$tmp/npmrc" npm whoami --registry "$registry" > /dev/null 2>&1 \
    || { echo "packages:publish: $registry refuses the token npm would publish $name with (check the app's .npmrc)." >&2; exit 1; }
  # Only "not found" means not published: any other answer (a refused token, a network error) stops here,
  # before a publish that would fail the same way after the tag is pushed.
  if NPM_CONFIG_USERCONFIG="$tmp/npmrc" npm view "$name@$version" version --registry "$registry" > "$tmp/view" 2>&1; then
    echo "$name@$version is already published."
  elif grep -q "E404" "$tmp/view"; then
    NPM_CONFIG_USERCONFIG="$tmp/npmrc" npm publish --workspace "$name" --ignore-scripts ${dry[@]+"${dry[@]}"}
  else
    echo "packages:publish: $registry did not answer for $name@$version:" >&2; cat "$tmp/view" >&2; exit 1
  fi
done < <(node "$here/workspaces.mjs")

if [ -n "$tag" ] && [ ${#dry[@]} -eq 0 ]; then
  if gh release view "$tag" >/dev/null 2>&1; then echo "$tag is already released."; exit 0; fi
  gh release create "$tag" --title "${RELEASE_TITLE:-$RELEASE_PACKAGE} ${tag#v}" --notes-file "$tmp/notes.md"
  echo "Released $tag."
fi

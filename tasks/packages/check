#!/usr/bin/env bash
#MISE description="Preview the latest npm versions of this repository's own dependencies (the root's and every workspace's) without changing files (~10 s, needs the network). Its own workspaces and @joeblew999/remy-ui are left out: the platform moves with project:upgrade-ui"
#MISE dir="{{config_root}}"
# In TypeScript now (packages/ui/src/cli/packages.ts): this task forwards for whoever still types mise run, and goes with mise.
if [ -f packages/ui/src/cli/remy.ts ]; then exec node packages/ui/src/cli/remy.ts packages check "$@"; fi
exec node ./node_modules/@joeblew999/remy-ui/cli/remy.js packages check "$@"

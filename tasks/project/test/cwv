#!/usr/bin/env bash
#MISE description="Level 2, speed: Google's Core Web Vitals (Lighthouse's own mobile and desktop measurement, median of 5) judged on a throwaway Cloudflare Worker of this commit (cf:preview), deleted afterwards, not localhost (~3 min). On localhost the scripts arrive before the first paint in an order no visitor or Google sees, which Lighthouse's simulation misjudges; the thresholds are the same either way. Builds into dist/: not alongside a local level"
#MISE dir="{{config_root}}"
#USAGE arg "[alias]" help="Preview alias; defaults to the current git branch"
set -euo pipefail
log="$(mktemp)"
# The throwaway check Worker is kept for the speed run, then deleted whatever happens.
cleanup() {
  status=$?
  name="$(sed -n 's/^Target: Cloudflare (remote), throwaway Worker \([^ ]*\) at .*/\1/p' "$log" 2>/dev/null | tail -1)"
  rm -f "$log"
  [ -z "$name" ] || "$(dirname "$0")/../../cf/preview-delete" "$name" || echo "project:test:cwv: could not delete $name; run mise run cf:preview-delete -- $name" >&2
  exit "$status"
}
trap cleanup EXIT
KEEP_PREVIEW=1 mise run cf:preview ${usage_alias:+"$usage_alias"} | tee "$log"
origin="$(sed -n 's/^Preview passed level 1: \(https:[^ ]*\)$/\1/p' "$log" | tail -1)"
[ -n "$origin" ] || { echo "project:test:cwv: cf:preview did not report its origin" >&2; exit 1; }
# One speed measurement at a time on this machine: a second run waits for the lock (see project:test:google).
lock="${TMPDIR:-/tmp}/remy-level2.lock"
if command -v flock >/dev/null; then locker=(flock "$lock"); else locker=(lockf -k "$lock"); fi
TEST_BASE_URL="$origin" TEST_TARGET=remote "${locker[@]}" ./node_modules/.bin/playwright test --project=google-cwv --no-deps
echo "Core Web Vitals passed on $origin"

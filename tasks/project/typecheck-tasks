#!/usr/bin/env bash
#MISE description="Check the shared tasks' own TypeScript (tasks/**/*.ts, tasks/tsconfig.json) with the app's tsc, wherever the tasks are: this repository, or mise's cache of the include in a consumer (~1 s). project:typecheck runs it, so a task that no longer compiles fails the check, not the deploy"
#MISE dir="{{config_root}}"
set -euo pipefail
# A file task knows its own folder; a TOML task in an include does not, which is why this is a file.
# The packages the tasks import resolve from the app: in a consumer the tasks sit in mise's cache with
# no node_modules above them, so the app's is linked next to the tasks folder (beside, never inside it:
# mise reads every TOML under tasks/ as a task file). In this repository that folder is the repo root,
# which has its own node_modules already.
tasks="$(cd "$(dirname "$0")/.." && pwd)"
[ -e "$tasks/../node_modules" ] || ln -s "$PWD/node_modules" "$tasks/../node_modules"
exec ./node_modules/.bin/tsc -p "$tasks/tsconfig.json"

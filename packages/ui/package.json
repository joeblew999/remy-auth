    "./playwright": "./src/playwright.js",
    "./components/*": "./src/components/*.tsx"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.0.0",
    "@playwright/test": "^1.63.0",
    "lighthouse": "^13.5.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",

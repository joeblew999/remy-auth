    "./styles.css": "./src/styles.css",
    "./messages": "./src/paraglide/messages.js",
    "./runtime": "./src/paraglide/runtime.js",
    "./locale": "./src/locale.ts",
    "./locale-info": "./src/locale-info.ts",
    "./seo": "./src/seo.ts",
    "./language": "./src/language.tsx",
    "./client": "./src/client.tsx",

{
  "name": "@joeblew999/remy-ui",
  "version": "0.6.0",
  "description": "Remy shared UI: shadcn/Base UI controls, theme, Paraglide catalogs and locale helpers for server- and client-rendered apps",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeblew999/remy-auth.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "src",
    "README.md"
  ],
  "exports": {

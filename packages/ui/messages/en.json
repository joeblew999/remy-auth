  "instant_value": [
    {
      "declarations": [
        "input instant",
        "local formatted = instant: datetime dateStyle=full timeStyle=long timeZone=UTC"
      ],
      "match": {
        "instant=*": "{formatted}"
      }
    }
  ],
  "plain_date_value": [
    {
      "declarations": [
        "input date",
        "local formatted = date: datetime dateStyle=long timeZone=UTC"
      ],
      "match": {
        "date=*": "{formatted}"
      }
    }
  ],
  "relative_value": [
    {
      "declarations": [
        "input days",
        "local formatted = days: relativetime unit=day numeric=auto"
      ],
      "match": {
        "days=*": "{formatted}"
      }
    }
  ],
  "decimal_value": [
    {
      "declarations": [
        "input value",
        "local formatted = value: number"
      ],
      "match": {
        "value=*": "{formatted}"
      }
    }
  ],
  "percent_value": [
    {
      "declarations": [
        "input value",
        "local formatted = value: number style=percent"
      ],
      "match": {
        "value=*": "{formatted}"
      }
    }
  ],
  "currency_value": [
    {
      "declarations": [
        "input amount",
        "local formatted = amount: number style=currency currency=EUR"
      ],
      "match": {
        "amount=*": "{formatted}"
      }
    }
  ],
  "apps_count": [
    {
      "declarations": [
        "input count",
        "local countPlural = count: plural"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{count} app",
        "countPlural=other": "{count} apps"
      }
    }
  ],

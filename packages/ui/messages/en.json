    {
      "declarations": [
        "input km",
        "local formatted = km: number style=unit unit=kilometer unitDisplay=long"
      ],
      "match": {
        "km=*": "{formatted}"
      }
    }
  ],
  "compact_value": [
    {
      "declarations": [
        "input value",
        "local formatted = value: number notation=compact"
      ],
      "match": {
        "value=*": "{formatted}"
      }
    }
  ],
  "position_value": [
    {
      "declarations": [
        "input n",
        "local ordinal = n: plural type=ordinal"
      ],
      "selectors": [
        "ordinal"
      ],
      "match": {
        "ordinal=one": "{n}st",
        "ordinal=two": "{n}nd",
        "ordinal=few": "{n}rd",
        "ordinal=other": "{n}th"
      }
    }
  ],
  "invite_status": [
    {
      "declarations": [
        "input status"
      ],
      "selectors": [
        "status"
      ],
      "match": {
        "status=accepted": "Invitation accepted",
        "status=declined": "Invitation declined",
        "status=*": "Invitation pending"
      }
    }
  ],
  "reserved": [
    {
      "declarations": [
        "input name",
        "input count",
        "local countPlural = count: plural"
      ],
      "selectors": [
        "countPlural"
      ],
      "match": {
        "countPlural=one": "{name} reserved {count} seat.",
        "countPlural=other": "{name} reserved {count} seats."
      }
    }
  ],

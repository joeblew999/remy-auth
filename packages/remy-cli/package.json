{
  "name": "@joeblew999/remy-cli",
  "version": "0.16.0",
  "description": "The Remy command line (remy, remy-check): the project's checks, translations, the docs' AI, browser checks against a deployment, and upgrades for every Remy app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeblew999/remy-auth.git",
    "directory": "packages/remy-cli"
  },
  "bin": {
    "remy": "./src/remy.ts",
    "remy-check": "./src/checks.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./checks": "./src/checks.ts",
    "./remy": "./src/remy.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "remy": "./dist/remy.mjs",
      "remy-check": "./dist/checks.mjs"
    },
    "exports": {
      "./checks": "./dist/checks.mjs",
      "./remy": "./dist/remy.mjs",
      "./package.json": "./package.json"
    },
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@joeblew999/remy-ui": "workspace:*",
    "@playwright/test": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
